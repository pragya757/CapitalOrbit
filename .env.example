# CapitalOrbit Production Environment Variables Template
# Copy this template to your deployment dashboard (e.g., Vercel Project Settings -> Environment Variables)

# 1. Database Configuration (Supabase PostgreSQL / Hosted Postgres)
# Shared transaction-mode pooler (Port 6543 for pgbouncer)
DATABASE_URL="postgresql://postgres.your_ref:your_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Shared session-mode pooler (Port 5432 for migrations)
DIRECT_URL="postgresql://postgres.your_ref:your_password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# 2. Authentication & Security Secrets (Server-Only Secrets)
# Secret key used to sign JWT authentication cookies (min 32 characters)
JWT_SECRET="your_production_jwt_secret_key_change_me"

# 32-byte secret for AES-256-GCM symmetric database field encryption
ENCRYPTION_KEY="your_production_32_byte_encryption_key"

# 3. Razorpay Credentials (Test / Live Mode)
# Obtain API keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"

# Public key ID consumed by browser checkout dialog
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"

# Optional webhook secret for verifying incoming webhook events from Razorpay
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"
